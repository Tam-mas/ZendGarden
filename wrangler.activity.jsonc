{
  "name": "zend-garden-activity-snapshot",
  "main": "analytics/snapshot-worker.js",
  "compatibility_date": "2026-09-18",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["5 0 * * *"] },
  "d1_databases": [
    { "binding": "GARDEN_STATS", "database_name": "zend-garden-stats",
