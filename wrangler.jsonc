{
  "name": "zendgarden",
  "pages_build_output_dir": "./build/web",
  "compatibility_date": "2026-09-18",
  "vars": { "ZEND_ANALYTICS_ENABLED": "true" },
  "d1_databases": [
    { "binding": "GARDEN_STATS", "database_name": "zend-garden-stats",
      "database_id": "b835ab95-073f-4619-b53e-6bb43d07e568" }
  ],
  // Previews and local builds never write production statistics.
  "env": {
    "preview": {
      "vars": { "ZEND_ANALYTICS_ENABLED": "false" },
      "d1_databases": []
    }
  }
}
